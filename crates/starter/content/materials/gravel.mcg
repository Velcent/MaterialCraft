# Gravel: a starter material (MaterialCraft's own graph, Metallic Roughness outputs)
size 1024
node 1 voronoi scale=18 jitter=1 mode=4 seed=12
node 2 levels in=@1 low=0.02 high=0.35 gamma=2.2
node 3 voronoi scale=18 jitter=1 mode=1 seed=12
node 4 voronoi scale=29 jitter=1 mode=4 seed=31
node 5 levels in=@4 low=0.02 high=0.35 gamma=2.2 out_high=0.8
node 6 blend fg=@5 bg=@2 mode=6 opacity=1
node 7 voronoi scale=29 jitter=1 mode=1 seed=31
node 8 blend fg=@7 bg=@3 mask=@5 mode=0
node 9 fbm scale=24 octaves=4 seed=4
node 10 blend fg=@9 bg=@8 mode=5 opacity=0.4
node 11 colorize in=@10 p0=0 r0=0.25 g0=0.24 b0=0.23 p1=0.5 r1=0.48 g1=0.46 b1=0.43 p2=1 r2=0.66 g2=0.63 b2=0.58
node 13 levels in=@6 low=0 high=0.15
node 14 color r=0.08 g=0.07 b=0.06
node 15 blend fg=@11 bg=@14 mask=@13 mode=0
node 16 levels in=@9 out_low=0.95 out_high=0.7
node 90 normal in=@6 strength=4
node 91 ao in=@6 radius=6 intensity=3
node 93 color r=0 g=0 b=0
output basecolor 15
output normal 90
output roughness 16
output metallic 93
output height 6
output ambient_occlusion 91
