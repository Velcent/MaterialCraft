# Asphalt: a starter material (MaterialCraft's own graph, Metallic Roughness outputs)
size 1024
node 1 gaussian_noise scale=2 seed=8
node 2 voronoi scale=64 jitter=1 mode=1 seed=5
node 3 voronoi scale=64 jitter=1 mode=4 seed=5
node 4 levels in=@3 low=0.1 high=0.2
node 5 blend fg=@2 bg=@1 mask=@4 mode=0 opacity=0.6
node 6 fbm scale=3 octaves=5 seed=19
node 7 blend fg=@6 bg=@5 mode=5 opacity=0.35
node 8 colorize in=@7 p0=0 r0=0.10 g0=0.10 b0=0.105 p1=1 r1=0.32 g1=0.32 b1=0.31
node 9 levels in=@7 out_low=0.96 out_high=0.82
node 10 levels in=@7 out_low=0.46 out_high=0.54
node 90 normal in=@10 strength=1.5
node 91 ao in=@10 radius=6 intensity=1.5
node 93 color r=0 g=0 b=0
output basecolor 8
output normal 90
output roughness 9
output metallic 93
output height 10
output ambient_occlusion 91
