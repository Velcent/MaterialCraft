# Rubber: a starter material (MaterialCraft's own graph, Metallic Roughness outputs)
size 1024
node 1 voronoi scale=48 jitter=0.8 mode=0 seed=6
node 2 levels in=@1 out_low=0.56 out_high=0.44
node 3 fbm scale=4 octaves=4 seed=3
node 4 colorize in=@3 p0=0 r0=0.06 g0=0.06 b0=0.065 p1=1 r1=0.11 g1=0.11 b1=0.115
node 5 levels in=@3 out_low=0.6 out_high=0.7
node 90 normal in=@2 strength=1
node 91 ao in=@2 radius=6 intensity=1.5
node 93 color r=0 g=0 b=0
output basecolor 4
output normal 90
output roughness 5
output metallic 93
output height 2
output ambient_occlusion 91
