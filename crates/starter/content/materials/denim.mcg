# Denim: a starter material (MaterialCraft's own graph, Metallic Roughness outputs)
size 1024
node 1 stripes count=64 angle=0.125 softness=0.35 width=0.55
node 2 directional_noise scale=64 stretch=8 angle=0.25 seed=12
node 3 blend fg=@2 bg=@1 mode=5 opacity=0.5
node 4 white_noise seed=4
node 5 levels in=@4 low=0.9 high=1
node 6 fbm scale=3 octaves=4 seed=15
node 7 colorize in=@6 p0=0 r0=0.10 g0=0.17 b0=0.32 p1=1 r1=0.26 g1=0.36 b1=0.54
node 8 blend fg=@3 bg=@7 mode=3 opacity=0.4
node 9 color r=0.8 g=0.82 b=0.86
node 10 blend fg=@9 bg=@8 mask=@5 mode=0 opacity=0.35
node 11 levels in=@3 out_low=0.95 out_high=0.82
node 90 normal in=@3 strength=2
node 91 ao in=@3 radius=6 intensity=1.5
node 93 color r=0 g=0 b=0
output basecolor 10
output normal 90
output roughness 11
output metallic 93
output height 3
output ambient_occlusion 91
