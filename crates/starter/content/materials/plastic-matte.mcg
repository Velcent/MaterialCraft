# Matte plastic: a starter material (MaterialCraft's own graph, Metallic Roughness outputs)
size 1024
node 1 gaussian_noise scale=1 seed=11
node 2 blur in=@1 radius=1
node 3 color r=0.42 g=0.43 b=0.45
node 4 levels in=@2 out_low=0.55 out_high=0.68
node 5 levels in=@2 out_low=0.47 out_high=0.53
node 90 normal in=@5 strength=1
node 91 ao in=@5 radius=6 intensity=1.5
node 93 color r=0 g=0 b=0
output basecolor 3
output normal 90
output roughness 4
output metallic 93
output height 5
output ambient_occlusion 91
