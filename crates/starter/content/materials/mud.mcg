# Mud: a starter material (MaterialCraft's own graph, Metallic Roughness outputs)
size 1024
node 1 fbm scale=4 octaves=7 seed=33
node 2 clouds scale=3 seed=8
node 3 blend fg=@2 bg=@1 mode=5 opacity=0.5
node 4 levels in=@3 low=0.38 high=0.46
node 5 colorize in=@3 p0=0 r0=0.15 g0=0.10 b0=0.06 p1=1 r1=0.34 g1=0.24 b1=0.14
node 6 tint in=@5 r=0.55 g=0.55 b=0.55
node 7 blend fg=@5 bg=@6 mask=@4 mode=0
node 8 levels in=@4 out_low=0.08 out_high=0.85
node 9 levels in=@3 low=0.42 high=1 out_low=0.42 out_high=0.7
node 90 normal in=@9 strength=3
node 91 ao in=@9 radius=6 intensity=1.5
node 93 color r=0 g=0 b=0
output basecolor 7
output normal 90
output roughness 8
output metallic 93
output height 9
output ambient_occlusion 91
