# Sand: a starter material (MaterialCraft's own graph, Metallic Roughness outputs)
size 1024
node 1 fbm scale=2 octaves=3 seed=4
node 2 waveform count=14 angle=0.05 warp=0.3 warp_scale=2 seed=6 shape=0
node 3 warp in=@2 warp=@1 intensity=0.08
node 4 gaussian_noise scale=1 seed=3
node 5 blend fg=@4 bg=@3 mode=5 opacity=0.25
node 6 colorize in=@5 p0=0 r0=0.66 g0=0.55 b0=0.38 p1=1 r1=0.86 g1=0.76 b1=0.58
node 7 levels in=@4 out_low=0.95 out_high=0.82
node 8 levels in=@5 out_low=0.46 out_high=0.54
node 90 normal in=@8 strength=1
node 91 ao in=@8 radius=6 intensity=1.5
node 93 color r=0 g=0 b=0
output basecolor 6
output normal 90
output roughness 7
output metallic 93
output height 8
output ambient_occlusion 91
