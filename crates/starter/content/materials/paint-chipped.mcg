# Chipped paint: a starter material (MaterialCraft's own graph, Metallic Roughness outputs)
size 1024
node 1 grunge_map map=4 seed=9
node 2 fbm scale=5 octaves=6 seed=2
node 3 blend fg=@2 bg=@1 mode=5 opacity=0.5
node 4 levels in=@3 low=0.33 high=0.36
node 5 fbm scale=24 octaves=4 seed=5
node 6 colorize in=@5 p0=0 r0=0.13 g0=0.27 b0=0.17 p1=1 r1=0.22 g1=0.40 b1=0.26
node 7 levels in=@5 out_low=0.52 out_high=0.64
node 8 blend fg=@6 bg=@7 mask=@4 mode=0
node 9 invert in=@4
node 10 levels in=@4 out_low=0.35 out_high=0.6
node 11 levels in=@4 out_low=0.44 out_high=0.56
node 90 normal in=@11 strength=3
node 91 ao in=@11 radius=6 intensity=1.5
output basecolor 8
output normal 90
output roughness 10
output metallic 9
output height 11
output ambient_occlusion 91
