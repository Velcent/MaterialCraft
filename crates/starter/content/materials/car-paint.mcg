# Car paint: a starter material (MaterialCraft's own graph, Metallic Roughness outputs)
size 1024
node 1 white_noise seed=9
node 2 levels in=@1 low=0.7 high=1
node 3 fbm scale=3 octaves=4 seed=6
node 4 colorize in=@3 p0=0 r0=0.42 g0=0.02 b0=0.03 p1=1 r1=0.58 g1=0.04 b1=0.05
node 5 blend fg=@2 bg=@4 mode=4 opacity=0.12
node 6 levels in=@2 out_low=0.22 out_high=0.34
node 7 levels in=@2 out_low=0.55 out_high=0.85
node 90 color r=0.5 g=0.5 b=1
node 91 color r=1 g=1 b=1
node 92 color r=0.5 g=0.5 b=0.5
output basecolor 5
output normal 90
output roughness 6
output metallic 7
output height 92
output ambient_occlusion 91
