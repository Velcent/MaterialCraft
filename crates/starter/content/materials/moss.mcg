# Moss: a starter material (MaterialCraft's own graph, Metallic Roughness outputs)
size 1024
node 1 fbm scale=5 octaves=7 seed=44
node 2 gaussian_noise scale=1 seed=6
node 3 blur in=@2 radius=0.6
node 4 blend fg=@3 bg=@1 mode=5 opacity=0.5
node 5 colorize in=@4 p0=0 r0=0.08 g0=0.13 b0=0.03 p1=0.5 r1=0.20 g1=0.32 b1=0.07 p2=1 r2=0.42 g2=0.52 b2=0.14
node 6 color r=0.95 g=0.95 b=0.95
node 90 normal in=@4 strength=3
node 91 ao in=@4 radius=6 intensity=2.5
node 93 color r=0 g=0 b=0
output basecolor 5
output normal 90
output roughness 6
output metallic 93
output height 4
output ambient_occlusion 91
